<% content_for :title, @room.name %>

<div class="page-header">
  <div>
    <h1><%= @room.name %></h1>
    <p class="muted"><%= pluralize(@room.capacity, "bed") %></p>
  </div>
</div>

<div class="actions-row">
  <%= link_to "Edit room", edit_room_path(@room), class: "button" %>
  <%= button_to "Delete room", @room, method: :delete, class: "button button-danger",
        form: { data: { turbo_confirm: "Delete this room?" } } %>
  <%= link_to "Back to rooms", rooms_path, class: "button button-secondary" %>
</div>

<h2>Reservations</h2>

<% if @reservations.any? %>
  <div id="reservations" class="card-grid">
    <%= render @reservations %>
  </div>
<% else %>
  <p class="muted">No reservations yet.</p>
<% end %>