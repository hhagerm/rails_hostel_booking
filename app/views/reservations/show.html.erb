<% content_for :title, "Reservation" %>

<div class="page-header">
  <h1>Reservation</h1>
</div>

<%= render @reservation %>

<div class="actions-row">
  <%= link_to "Edit", edit_reservation_path(@reservation), class: "button" %>
  <%= button_to "Delete", @reservation, method: :delete, class: "button button-danger",
        form: { data: { turbo_confirm: "Delete this reservation?" } } %>
  <%= link_to "Back to reservations", reservations_path, class: "button button-secondary" %>
</div>