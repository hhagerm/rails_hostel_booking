<div id="<%= dom_id reservation %>" class="card">
  <h3><%= link_to reservation.guest_name, reservation %></h3>
  <p class="muted"><%= link_to reservation.room.name, reservation.room %></p>
  <p>
    <%= reservation.start_date.strftime("%-d %b %Y") %> → <%= reservation.end_date.strftime("%-d %b %Y") %>
  </p>
  <p class="muted"><%= pluralize(reservation.nights, "night") %></p>
</div>